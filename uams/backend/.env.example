# UAMS 后端配置样例（复制为 backend/.env 后修改；.env 已被 .gitignore 忽略）
#
# 局域网部署前必须修改：DATABASE_URL 的数据库口令、JWT_SECRET。
# 未提供 .env 时后端会退回 app/core/config.py 的内置默认值（演示用，勿用于局域网）。

APP_ENV=development
DEBUG=true

# MySQL 8.4（PyMySQL 驱动）；生产/局域网部署请改成真实口令
DATABASE_URL=mysql+pymysql://uams_app:CHANGE_ME@127.0.0.1:3306/uams?charset=utf8mb4
DB_ECHO=false

# 必须替换为随机长字符串，例如：python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 允许跨域的前端来源（逗号分隔）。
# 本项目默认由 Vite 同源代理转发 /api，浏览器不会产生跨域请求，
# 因此局域网访问无需在此登记前端地址；仅当浏览器直连后端端口时才需要。
# 示例：CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.10:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
